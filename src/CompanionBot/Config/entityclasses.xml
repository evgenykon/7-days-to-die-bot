<configs>
  <append xpath="/entity_classes">
    <entity_class name="companionBot" extends="npcMeleeTemplate">
      <property name="Class" value="CompanionEntity, CompanionBot" />
      <property name="Mesh" value="#@modfolder(0-XNPCCore):Resources/XythNPCs.unity3d?Quinn_X" />
      <property name="IsEnemyEntity" value="false" />
      <property name="Health" value="500" />
      <property name="Group" value="CompanionBot" />
      <property name="MoveSpeed" value="0.15" />
      <property name="MoveSpeedAggro" value="0.15, 0.15" />
      <property name="MoveSpeedPanic" value="0.15" />
      <property name="AITask" value="" />
      <property name="AITarget" value="" />
      <effect_group name="CompanionSpeed">
        <passive_effect name="WalkSpeed" operation="base_set" value="0.15" />
        <passive_effect name="RunSpeed" operation="base_set" value="0.15" />
      </effect_group>
    </entity_class>
  </append>
</configs>
